#!/usr/bin/env bash
# .git/hooks/prepare-commit-msg

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Skip for merges, squashes, amends, and messages passed via -m
# (remove the "message" case if you want -m commits prefixed too)
case "$COMMIT_SOURCE" in
  merge|squash|commit|message) exit 0 ;;
esac

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0

# Match TICKET-NNNN anywhere in the branch name
TICKET=$(echo "$BRANCH" | grep -oE '[A-Z]+-[0-9]+' | head -n1)
[ -z "$TICKET" ] && exit 0

# Don't double-prefix if it's already there
if ! grep -q "\[$TICKET\]" "$COMMIT_MSG_FILE"; then
  PREFIX="[$TICKET] "
  TEMP=$(mktemp)
  echo "$PREFIX$(cat "$COMMIT_MSG_FILE")" > "$TEMP"
  mv "$TEMP" "$COMMIT_MSG_FILE"
fi
